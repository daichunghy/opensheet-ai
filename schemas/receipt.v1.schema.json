{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheet-ai.dev/schemas/receipt.v1.schema.json",
  "title": "OpenSheet-AI Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planDigest",
    "status",
    "executedAt",
    "executor",
    "beforeDigest",
    "afterDigest",
    "operations",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "opensheet.receipt.v1" },
    "planDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["dry-run", "applied", "blocked"] },
    "executedAt": { "type": "string", "format": "date-time" },
    "executor": { "type": "string", "minLength": 1 },
    "beforeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "afterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projectedAfterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "status", "touchedCells"],
        "properties": {
          "operationId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "applied", "blocked"] },
          "touchedCells": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "operationId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
