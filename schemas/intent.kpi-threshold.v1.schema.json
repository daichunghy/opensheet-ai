{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheet-ai.dev/schemas/intent.kpi-threshold.v1.schema.json",
  "title": "OpenSheet-AI KPI Threshold Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "version", "workbook", "kpis"],
  "properties": {
    "module": { "const": "kpi-threshold" },
    "version": { "const": 1 },
    "workbook": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sheetName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "actual", "target"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 500 },
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "actual": { "type": "number" },
          "target": { "type": "number" },
          "warnBelow": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
