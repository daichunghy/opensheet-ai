{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheet-ai.dev/schemas/snapshot.v1.schema.json",
  "title": "OpenSheet-AI Workbook Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workbookId", "sheets"],
  "properties": {
    "schemaVersion": { "const": "opensheet.snapshot.v1" },
    "workbookId": { "type": "string", "minLength": 1 },
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "cellValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "kind", "value"],
          "properties": {
            "address": { "type": "string", "minLength": 1 },
            "kind": { "const": "value" },
            "value": { "$ref": "#/$defs/cellValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "kind", "formula"],
          "properties": {
            "address": { "type": "string", "minLength": 1 },
            "kind": { "const": "formula" },
            "formula": { "type": "string", "pattern": "^=" }
          }
        }
      ]
    },
    "format": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "bold": { "type": "boolean" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "wrap": { "type": "boolean" },
        "horizontalAlignment": { "enum": ["left", "center", "right"] }
      }
    },
    "validationRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values", "allowBlank"],
          "properties": {
            "kind": { "const": "list" },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/cellValue" }
            },
            "allowBlank": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max", "allowBlank"],
          "properties": {
            "kind": { "const": "number-between" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "allowBlank": { "type": "boolean" }
          }
        }
      ]
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cells", "validations", "formats", "frozen", "columnWidths"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\[\\]:*?/\\\\]{1,100}$"
        },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["range", "rule"],
            "properties": {
              "range": { "type": "string", "minLength": 1 },
              "rule": { "$ref": "#/$defs/validationRule" }
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["range", "format"],
            "properties": {
              "range": { "type": "string", "minLength": 1 },
              "format": { "$ref": "#/$defs/format" }
            }
          }
        },
        "frozen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "columns"],
          "properties": {
            "rows": { "type": "integer", "minimum": 0 },
            "columns": { "type": "integer", "minimum": 0 }
          }
        },
        "columnWidths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "width"],
            "properties": {
              "column": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
              "width": { "type": "number", "minimum": 1, "maximum": 400 }
            }
          }
        }
      }
    }
  }
}
