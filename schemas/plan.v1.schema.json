{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheet-ai.dev/schemas/plan.v1.schema.json",
  "title": "OpenSheet-AI Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "source", "target", "operations", "metadata"],
  "properties": {
    "schemaVersion": { "const": "opensheet.plan.v1" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version"],
      "properties": {
        "module": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbook"],
      "properties": {
        "workbook": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "cellValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "baseOperation": {
      "type": "object",
      "required": ["id", "kind", "sheet"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "type": "string" },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\[\\]:*?/\\\\]{1,100}$"
        }
      }
    },
    "range": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[1-9][0-9]*(?::[A-Z]{1,3}[1-9][0-9]*)?$"
    },
    "format": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "bold": { "type": "boolean" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "wrap": { "type": "boolean" },
        "horizontalAlignment": { "enum": ["left", "center", "right"] }
      }
    },
    "validationRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values", "allowBlank"],
          "properties": {
            "kind": { "const": "list" },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/cellValue" }
            },
            "allowBlank": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max", "allowBlank"],
          "properties": {
            "kind": { "const": "number-between" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "allowBlank": { "type": "boolean" }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet"],
              "properties": {
                "id": true,
                "kind": { "const": "ensure-sheet" },
                "sheet": true
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "range", "values"],
              "properties": {
                "id": true,
                "kind": { "const": "write-range" },
                "sheet": true,
                "range": { "$ref": "#/$defs/range" },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/cellValue" }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "range", "formulas"],
              "properties": {
                "id": true,
                "kind": { "const": "write-formulas" },
                "sheet": true,
                "range": { "$ref": "#/$defs/range" },
                "formulas": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^=" }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "range", "rule"],
              "properties": {
                "id": true,
                "kind": { "const": "set-data-validation" },
                "sheet": true,
                "range": { "$ref": "#/$defs/range" },
                "rule": { "$ref": "#/$defs/validationRule" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "range", "format"],
              "properties": {
                "id": true,
                "kind": { "const": "set-format" },
                "sheet": true,
                "range": { "$ref": "#/$defs/range" },
                "format": { "$ref": "#/$defs/format" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "rows", "columns"],
              "properties": {
                "id": true,
                "kind": { "const": "freeze-pane" },
                "sheet": true,
                "rows": { "type": "integer", "minimum": 0, "maximum": 100 },
                "columns": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOperation" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "sheet", "widths"],
              "properties": {
                "id": true,
                "kind": { "const": "set-column-widths" },
                "sheet": true,
                "widths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["column", "width"],
                    "properties": {
                      "column": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
                      "width": { "type": "number", "minimum": 1, "maximum": 400 }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
